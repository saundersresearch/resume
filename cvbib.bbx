\ProvidesFile{cvbib.bbx}[CV-style bibliography driver]

% ---- custom fields ------------------------------------------------------
% (declaring a field with datatype=boolean crashes this biber build, so
% "nohighlight" is a literal field checked against the string "true").
% Venue detail (journal/conference name, volume, pages, doi, ...) now lives
% in ordinary BibTeX fields -- journal/booktitle, volume, number, pages,
% year, doi, note -- instead of one hand-formatted "venue" string.
\DeclareDatamodelFields[type=field, datatype=literal]{groupcredit}
\DeclareDatamodelFields[type=field, datatype=literal]{nohighlight}

% ---- bold the CV owner's name wherever it appears as an author, and join
% the name list ourselves (", " between names, Oxford ", and " before the
% last) using biblatex's listcount/liststop position counters -----------
\DeclareNameFormat{default}{%
  \ifdefstring{\namepartfamily}{Saunders}
    {\iffieldequalstr{nohighlight}{true}{\let\cvwrap\relax}{\let\cvwrap\textbf}}
    {\let\cvwrap\relax}%
  \cvwrap{\ifdefvoid{\namepartgiven}{}{\namepartgiven\space}\namepartfamily}%
  \ifnumequal{\value{listcount}}{\value{liststop}}
    {}
    {\ifnumequal{\value{listcount}}{\numexpr\value{liststop}-1\relax}
       {\addcomma\space and\space}
       {\addcomma\space}}%
}

% ---- shared venue tail: just ", Year." -- or "." on its own when no year
% is on file yet (a submitted manuscript with no venue details settled).
% Volume/issue/page numbers are deliberately not printed here, even when
% present in the .bib data -- the CV lists venue and year only.
\newcommand{\cvbibvenuetail}{%
  \iffieldundef{year}{.}{,\space\printfield{year}.}}

% ---- one driver for every entry: Author list. "Title." Venue, Year. -----
% doi: ... Note. Author, title, the venue itself, doi, and note are all
% optional (Talks entries have neither an author byline nor a doi), so
% each piece only prints -- with its own trailing punctuation -- when
% actually present. Conference papers, abstracts, and talks are entered
% as @inproceedings (booktitle) rather than @article (journal); both
% share this one driver via the alias declared below. A journal name
% prints italicized and a conference/workshop name upright purely via
% each field's own \DeclareFieldFormat (set in the main .tex, since
% biblatex's default formats already italicize both fields by default --
% \printfield here must stay unadorned, with no \emph/\textit of its
% own: \emph toggles relative to whatever shape is already active, so
% wrapping an already-\mkbibemph'd field a second time flips it back off.
\DeclareBibliographyDriver{article}{%
  \ifnameundef{author}{}{%
    \printnames{author}%
    \iffieldundef{groupcredit}{}{\space\printfield{groupcredit}}%
    .\space}%
  \iffieldundef{title}{}{\textquotedblleft\printfield{title}\textquotedblright.\space}%
  % biblatex's default sourcemap silently renames the legacy BibTeX field
  % "journal" to "journaltitle" when biber reads the .bib files, so that
  % (not "journal") is the field name to test/print here.
  \iffieldundef{journaltitle}
    {\iffieldundef{booktitle}{}{\printfield{booktitle}\cvbibvenuetail}}
    {\printfield{journaltitle}\cvbibvenuetail}%
  \iffieldundef{doi}{}{\space doi:\space\printfield{doi}.}%
  \iffieldundef{note}{}{\space\printfield{note}}%
  \finentry}
\DeclareBibliographyAlias{inproceedings}{article}

% ---- environment that lays entries out in the CV's label column -------
% Every entry gets either a blank label column (published) or an italic
% status tag (set via \cvbibtag before each \printbibliography call: ""
% for published, "accepted"/"submitted" otherwise). The very first entry
% of a *section* (spanning possibly several \printbibliography calls --
% Conference Papers' accepted entries print before its plain published
% ones) also carries the bold section name, via \cvbibfirst/\cvbiblabel
% set once in the main document with \global since it must survive past
% this environment's own \endgroup.
%
% That first entry's label uses \cvlabelbox (defined in the main .tex,
% alongside \cvrow/\cvpar), so a name too wide for \cvlabelwidth (e.g.
% "Journal Articles") wraps onto a second line instead of overflowing,
% with no gap before the citation text that follows -- see \cvlabelbox's
% own comment for why a corrective depth override is needed for that. A
% status tag, if this first entry also has one, goes on its own line
% right after the label -- \bibpar inside the box -- landing under
% whichever line the label ended on. Every later entry's label is just a
% \makebox (blank, or the plain tag) -- \makebox, unlike \parbox, keeps
% its reserved width even completely empty, so it needs no such fix.
\newcounter{cvbibitem}
\providecommand{\cvbibtag}{}
\providecommand{\cvbiblabel}{}
\newif\ifcvbibfirst
% \defbibenvironment grabs its three arguments with a non-\long macro, so a
% bare \par token inside the braces looks like a runaway argument. Route
% through a differently-named alias instead.
\let\bibpar\par

% \hangindent set per item (the obvious approach) does not survive
% biblatex's internal per-entry processing (wrapped lines fell back to
% the left margin) -- but set *once* in this environment's begin-code,
% for the whole group, it does survive across every entry's \par. That
% also restores the property that made a wrapping \parbox label flush
% with its content in the first place (elsewhere in this document): line
% 1 of a \hangindent paragraph is exempt from the indent (\hangafter=1),
% so it's free to sit beside the label at full width, while only the
% lines after it -- from either the label overflowing or the citation
% itself wrapping -- get pushed to \cvlabelwidth.
\defbibenvironment{cvpub}
  {\bibpar
   \begingroup
   \hangindent=\cvlabelwidth\hangafter=1\relax
   \parindent=0pt\relax
   \setcounter{cvbibitem}{0}}
  {\bibpar\endgroup}
  {\bibpar
   \ifnumequal{\value{cvbibitem}}{0}{}{\ifdefempty{\cvbibtag}{\addvspace{6pt}}{\addvspace{10pt}}}%
   \noindent
   \ifcvbibfirst
     \cvlabelbox{\textbf{\cvbiblabel}%
       \ifdefempty{\cvbibtag}{}{\bibpar\textit{(\cvbibtag)}}}%
     \global\cvbibfirstfalse
   \else
     \ifdefempty{\cvbibtag}
       {\makebox[\cvlabelwidth][l]{}}
       {\makebox[\cvlabelwidth][l]{\textit{(\cvbibtag)}}}%
   \fi
   \stepcounter{cvbibitem}}

\endinput
